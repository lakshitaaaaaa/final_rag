# Free Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default Groq LLM model
# GROQ_MODEL_NAME=llama-3.1-8b-instant

# Optional: Whisper fallback for videos without YouTube captions.
# Requires ffmpeg installed locally. Set to false to disable.
# ENABLE_WHISPER_FALLBACK=true
# WHISPER_MODEL_NAME=whisper-large-v3-turbo
